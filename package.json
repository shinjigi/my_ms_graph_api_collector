{
  "name": "my_ms_graph_api_collector",
  "version": "1.0.0",
  "description": "Collector Node.js per Microsoft Graph (email, calendario, Teams)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "collect": "tsx src/index.ts",
    "collect:force": "tsx src/index.ts --force",
    "collect:auto": "tsx src/index.ts --aggregate",
    "collect:zucchetti:month": "tsx src/index.ts --source=zucchetti --year=2026 --month=03 --aggregate --force",
    "collect:range:zucchetti": "tsx src/collectors/zucchetti/index.ts --start=2025-06 --end=2026-03 --force",
    "collect:range:nibol": "tsx scripts/nibol/getCalendar.ts --start=2025-05-01 --end=2026-04-30",
    "aggregate": "tsx src/aggregators/aggregator.ts",
    "analyse": "tsx src/analysers/index.ts",
    "analyse:claude": "tsx src/analysers/index.ts --provider=claude",
    "analyse:gemini": "tsx src/analysers/index.ts --provider=gemini",
    "analyse:cli": "tsx src/analysers/index.ts --provider=cli",
    "analyse:ollama": "tsx src/analysers/index.ts --provider=ollama",
    "kb:update": "tsx src/targetprocess/collector.ts --update-kb",
    "kb:update:force": "tsx src/targetprocess/collector.ts --update-kb --force",
    "kb:update:force:replay": "tsx src/targetprocess/collector.ts --update-kb --force --from-enriched=data/raw/targetprocess/enriched-2026-03-23.json --from-ai-response=data/raw/ai-responses/2026-03-23_175054_gemini_kb-batch-1.json",
    "kb:update:gemini": "tsx src/targetprocess/collector.ts --update-kb --provider=gemini",
    "kb:update:gemini:force": "tsx src/targetprocess/collector.ts --update-kb --provider=gemini --force",
    "serve": "tsx src/server/app.ts",
    "all": "npm run collect && npm run aggregate && npm run analyse && npm run serve",
    "all:full": "npm run collect && npm run kb:update && npm run aggregate && npm run analyse && npm run serve",
    "zucchetti:get": "tsx --env-file=.env src/collectors/zucchetti/getTimesheet.ts",
    "zucchetti:get:date": "tsx --env-file=.env src/collectors/zucchetti/getTimesheet.ts --year=2025 --month=6 ",
    "zucchetti:update": "tsx --env-file=.env src/collectors/zucchetti/updateData.ts",
    "tp:log-time": "tsx scripts/tp/log-time.ts",
    "tp:projects": "tsx scripts/tp/get-projects.ts",
    "tp:userstories": "tsx scripts/tp/get-userstories.ts",
    "tp:us-detail": "tsx scripts/tp/get-us-detail.ts",
    "nibol:book": "tsx scripts/nibol/book_desk.ts",
    "nibol:book:date": "tsx scripts/nibol/book_desk.ts --date=2026-03-23",
    "nibol:calendar": "tsx scripts/nibol/getCalendar.ts",
    "nibol:status": "tsx scripts/test-nibol.ts",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "check": "npm run lint && npm run type-check",
    "lint": "eslint ."
  },
  "keywords": [
    "microsoft-graph",
    "msal",
    "teams",
    "outlook",
    "calendar",
    "targetprocess",
    "timetracking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@azure/msal-node": "^2.8.0",
    "@google/genai": "^1.46.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@types/xml2js": "^0.4.14",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "glob": "^13.0.6",
    "isomorphic-fetch": "^3.0.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.58.2",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.4",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.4.0",
    "@types/sql.js": "^1.4.9",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
