{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Serve (Express Debug)",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx", "src/server/app.ts"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": { "ZUCCHETTI_HEADLESS": "false" },
            "sourceMaps": true,
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug TS (Current File)",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx", "${file}"],
            "args": ["--date=${input:debugDate}", "--full-day=true"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": { "ZUCCHETTI_HEADLESS": "false" },
            "sourceMaps": true,
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug zucchetti:update",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx", "--env-file=.env", "src/collectors/zucchetti/updateData.ts"],
            "args": ["--date=${input:debugDate}", "--full-day=true", "--scrape-after-submit=true"],
            "cwd": "${workspaceFolder}",
            "env": { "ZUCCHETTI_HEADLESS": "false" },
            "sourceMaps": true,
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Execute current JS/MJS Script",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash-Debug (select script from list of sh files)",
            "cwd": "${workspaceFolder}",
            "program": "${command:SelectScriptName}",
            "args": []
        },
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash-Debug (simplest configuration)",
            "program": "${file}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Vue (Vite)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/web",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*",
                "vite/gui/*": "${webRoot}/*"
            },
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
        }
    ],
    "inputs": [
        {
            "id": "debugDate",
            "type": "promptString",
            "description": "Data (YYYY-MM-DD)",
            "default": "2026-05-20"
        }
    ]
}
